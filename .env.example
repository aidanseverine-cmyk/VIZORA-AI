# GEMINI_API_KEY: Required for Gemini AI API calls (Veo Video Generation, Prompt Enhancer, Story Breakdown, TTS Voiceover, Music & Captions).
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# VIZORA_VIDEO_PROVIDER: Configurable AI video provider (VEO_3_1, RUNWAY_GEN3, LUMA_DREAM_MACHINE, KLING_AI)
VIZORA_VIDEO_PROVIDER=VEO_3_1
